{
  "version": 2,
  "buildCommand": "npm run build:viewer",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/app.js",
      "destination": "/app.js"
    },
    {
      "source": "/viewer/(.*)",
      "destination": "/viewer/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
